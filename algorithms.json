{
  "capabilities":[
    {
      "name":"path_planning",
      "roles":["uav"],
      "description":"根据任务起飞点、目标点、地图文件、盲区文件、畅通区文件，生成可执行航线对应的文件",
      "executor":"tool",
      "executable":"C:\\Users\\EHz\\Desktop\\agentSkills\\pathplanning\\pathPlannning.exe",
      "input_schema":{
        "startPositionLong":{
          "type":"object",
          "format":"comma",
          "description":"起点经度"
        },
        "startPositionLat":{
          "type":"object",
          "format":"comma",
          "description":"起点纬度"
        },
        "destinationLong":{
          "type":"object",
          "format":"comma",
          "description":"终点经度"
        },
        "destinationLat":{
          "type":"object",
          "format":"comma",
          "description":"终点纬度"
        },
        "map":{
          "type":"file",
          "description":"存储地图信息的文件"
        },
        "bilndArea":{
          "type":"file",
          "description":"盲区信息的文件"
        },
        "coverageArea":{
          "type":"file",
          "description":"畅通区信息的文件"
        }
      },
      "output_schema":{
        "path":{
          "type":"array",
          "description":"航迹点列表，每个航迹点为 (经度,纬度,高度,时间) 四元组，如 (70,15.01,0,0)"
        }
      },
      "done_when":"工具返回成功",
      "failure_policy":"执行失败根据失败信息思考原因并再次执行"
    },
    {
      "name":"flight",
      "roles":["uav"],
      "description":"根据路径规划（path_planning）生成的航迹点沿航线飞行，模拟执行、不真实飞行。输入航迹点每个为(时间,经度,纬度,高度)四元组，如(0,70,15.01,0)",
      "executor":"tool",
      "input_schema":{
        "waypoints":{
          "type":"array",
          "description":"路径规划输出的航迹点列表，每个航迹点为(时间,经度,纬度,高度)四元组，如(0,70,15.01,0)"
        }
      },
      "output_schema":{
      },
      "done_when":"工具返回成功",
      "failure_policy":"执行失败根据失败信息思考原因并再次执行"
    },
    {
