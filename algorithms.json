        "tMinFreq":{
          "type":"number",
          "format":"frequency",
          "description":"对方通信最低频率（如 2GHz，执行时统一换算 MHz）"
        },
        "tMaxFreq":{
          "type":"number",
          "format":"frequency",
          "description":"对方通信最高频率（如 3GHz，执行时统一换算 MHz）"
        },
        "tBand":{
          "type":"string",
          "description":"对方带宽"
