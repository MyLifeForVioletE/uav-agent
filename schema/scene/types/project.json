{
    "project":{
        "类型":"struct",
        "描述":"仿真项目信息",
        "参数":{
            "项目ID":{
                "类型":"string",
                "描述":"项目的唯一标识ID",
                "默认值":""
            },
            "项目名称":{
                "类型":"string",
                "描述":"项目名称",
                "默认值":""
            },
            "仿真开始时间":{
                "类型":"string",
                "描述":"仿真开始时间",
                "默认值":""
            },
            "仿真结束时间":{
                "类型":"string",
                "描述":"仿真结束时间",
                "默认值":""
            },
            "项目创建时间":{
                "类型":"int",
                "描述":"项目创建时间，Unix时间戳",
                "默认值":""
            },
            "仿真步进":{
                "类型":"int",
                "描述":"仿真时间步进间隔",
                "单位":"秒",
                "默认值":""
            },
            "项目区域矢量ID":{
                "类型":"string",
                "描述":"项目关联的区域矢量ID",
                "默认值":""
            },
            "用户ID":{
                "类型":"int",
                "描述":"项目所属用户ID",
                "默认值":""
            },
            "备注":{
                "类型":"string",
                "描述":"项目备注信息",
                "默认值":""
            },
            "项目模板标识":{
                "类型":"int",
                "描述":"项目模板标识，区分不同项目模板",
                "默认值":""
            },
            "project_vector_extd":{
                "类型":"array",
                "描述":"项目矢量扩展坐标点信息，包含经纬度、高度、距离间隔及运动时间",
                "参数":{
                    "主键ID":{
                        "类型":"string",
                        "描述":"记录唯一主键ID",
                        "默认值":""
                    },
                    "项目矢量ID":{
                        "类型":"string",
                        "描述":"关联的项目矢量ID",
                        "默认值":""
                    },
                    "经度":{
                        "类型":"double",
                        "描述":"坐标点经度，东经为正，西经为负，单位：度",
                        "单位":"度",
                        "默认值":""
                    },
                    "纬度":{
                        "类型":"double",
                        "描述":"坐标点纬度，北纬为正，南纬为负，单位：度",
                        "单位":"度",
                        "默认值":""
                    },
                    "高度":{
                        "类型":"double",
                        "描述":"坐标点海拔高度，单位：米",
                        "单位":"米",
                        "默认值":""
                    },
                    "距起始点距离":{
                        "类型":"string",
                        "描述":"该坐标点距离矢量起点的距离，单位：千米",
                        "单位":"千米",
                        "默认值":""
                    },
                    "从起始点运动到该点的时间间隔":{
                        "类型":"int",
                        "描述":"从起点运动到该坐标点所需时间，单位：秒",
                        "单位":"秒",
                        "默认值":""
                    },
                    "载体运动的总时间":{
                        "类型":"string",
                        "描述":"载体沿矢量运动的总时间",
                        "默认值":""
                    }
                }
            },
            "project_vector":{
                "类型":"array",
                "描述":"项目区域矢量信息，包含矢量标识、类型、关联项目与载体",
                "参数":{
                    "矢量ID":{
                        "类型":"string",
                        "描述":"矢量的唯一标识ID",
                        "默认值":""
                    },
                    "矢量名称":{
                        "类型":"string",
                        "描述":"矢量名称",
                        "默认值":""
                    },
                    "项目ID":{
                        "类型":"string",
                        "描述":"关联的项目ID",
                        "默认值":""
                    },
                    "载体ID":{
                        "类型":"string",
                        "描述":"关联的载体ID",
                        "默认值":""
                    },
                    "矢量类型":{
                        "类型":"string",
                        "描述":"矢量类型，如区域边界、飞行路径、禁飞区等",
                        "默认值":""
                    },
                    "用户ID":{
                        "类型":"int",
                        "描述":"所属用户ID",
                        "默认值":""
                    },
                    "备注":{
                        "类型":"string",
                        "描述":"矢量备注信息",
                        "默认值":""
                    }
                }
            }
        }
    }
}
