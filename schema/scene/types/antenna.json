{
    "antenna":{
        "参数":{
            "天线id":{
                "类型":"string",
                "描述":"天线唯一标识ID",
                "默认值":""
            },
            "天线名称":{
                "类型":"string",
                "描述":"天线名称或代号",
                "默认值":""
            },
            "天线类型":{
                "类型":"string",
                "描述":"天线类型，如定向天线、全向天线、抛物面天线等",
                "默认值":""
            },
            "天线制造商":{
                "类型":"string",
                "描述":"天线制造商",
                "默认值":""
            },
            "模型精度参数":{
                "类型":"string",
                "描述":"设置模型计算精度，用于控制模型计算过程中采用的数值精度",
                "默认值":""
            },
            "天线增益":{
                "类型":"int",
                "描述":"天线增益，单位：dBi",
                "默认值":""
            },
            "水平波束宽度":{
                "类型":"string",
                "描述":"水平波束宽度（HBeamwidth），天线在水平面上的主瓣宽度，单位：度",
                "默认值":""
            },
            "垂直波束宽度":{
                "类型":"string",
                "描述":"垂直波束宽度（VBeamwidth），天线在垂直面上的主瓣宽度，单位：度",
                "默认值":""
            },
            "前后比":{
                "类型":"int",
                "描述":"前后比（frontToBack），天线最大辐射方向与相反方向辐射强度之比，单位：dB",
                "默认值":""
            },
            "天线长度":{
                "类型":"string",
                "描述":"天线长度（antLength），天线物理长度，单位：米",
                "默认值":""
            },
            "波束下倾角":{
                "类型":"string",
                "描述":"波束下倾角（lobeTilt），天线波束指向水平面以下的倾斜角度，单位：度",
                "默认值":""
            },
            "迎风面积":{
                "类型":"int",
                "描述":"迎风面积（windArea），天线在风载荷方向上的投影面积，单位：平方米",
                "默认值":""
            },
            "测量频率":{
                "类型":"string",
                "描述":"测量频率（measFreq），天线参数测量时使用的频率，单位：MHz",
                "默认值":""
            },
            "频率下限":{
                "类型":"string",
                "描述":"频率下限（lowFreq），天线工作频率范围的最低值，单位：MHz",
                "默认值":""
            },
            "频率上限":{
                "类型":"int",
                "描述":"频率上限（highFreq），天线工作频率范围的最高值，单位：MHz",
                "默认值":""
            },
            "极化方式":{
                "类型":"string",
                "描述":"极化方式（polar），天线辐射电磁波的极化类型，如水平极化、垂直极化、圆极化等",
                "默认值":""
            },
            "极化隔离度":{
                "类型":"string",
                "描述":"极化隔离度（polarCrossIso），天线不同极化端口之间的隔离程度，单位：dB",
                "默认值":""
            },
            "特性阻抗":{
                "类型":"int",
                "描述":"特性阻抗（impede），天线的输入/输出特性阻抗，单位：欧姆",
                "默认值":""
            },
            "其他损耗":{
                "类型":"string",
                "描述":"其他损耗（otherLoss），天线系统中除增益外的附加损耗，单位：dB",
                "默认值":""
            },
            "备注":{
                "类型":"string",
                "描述":"备注（memo），天线相关信息备注",
                "默认值":""
            },
            "创建时间":{
                "类型":"int",
                "描述":"创建时间（antCrdate），天线记录的创建时间，Unix时间戳",
                "默认值":""
            },
            "最后修改时间":{
                "类型":"string",
                "描述":"最后修改时间（antLwrdate），天线记录的最后修改时间",
                "默认值":""
            },
            "垂直天线方向图":{
                "类型":"array",
                "描述":"垂直天线方向图，每个角度一个点",
                "参数":{
                    "垂直角度":{
                        "类型":"string",
                        "描述":"垂直角度（VAngle），天线垂直方向图的角度值，单位：度",
                        "默认值":""
                    },
                    "损耗":{
                        "类型":"string",
                        "描述":"损耗（loss），对应垂直角度的天线增益/损耗值，单位：dB",
                        "默认值":""
                    }
                },
                "默认值":[]
            },
            "水平天线方向图":{
                "类型":"array",
                "描述":"水平天线方向图，每个角度一个点",
                "参数":{
                    "水平角度":{
                        "类型":"string",
                        "描述":"水平角度（HAngle），天线水平方向图的角度值，单位：度",
                        "默认值":""
                    },
                    "损耗":{
                        "类型":"string",
                        "描述":"损耗（loss），对应水平角度的天线增益/损耗值，单位：dB",
                        "默认值":""
                    }
                },
                "默认值":[]
            }
        }
    }
}