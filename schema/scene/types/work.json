{
    "work":{
        "类型":"struct",
        "描述":"装备工作参数模板，包含收发频率、天线角度、功率、调制方式及干扰保护门限",
        "参数":{
            "工作参数ID":{
                "类型":"int",
                "描述":"工作参数模板的唯一标识ID",
                "默认值":""
            },
            "开始时间":{
                "类型":"string",
                "描述":"工作参数生效的开始时间",
                "默认值":""
            },
            "结束时间":{
                "类型":"string",
                "描述":"工作参数生效的结束时间",
                "默认值":""
            },
            "发射频率":{
                "类型":"int",
                "描述":"发射设备的工作频率，单位：MHz",
                "单位":"MHz",
                "默认值":""
            },
            "发射天线方位角":{
                "类型":"int",
                "描述":"发射天线水平指向的方位角，以正北为0度顺时针旋转，单位：度",
                "单位":"度",
                "默认值":""
            },
            "发射天线俯仰角":{
                "类型":"int",
                "描述":"发射天线垂直方向的俯仰角度，0度为水平，正值为向上，单位：度",
                "单位":"度",
                "默认值":""
            },
            "接收频率":{
                "类型":"int",
                "描述":"接收设备的工作频率，单位：MHz",
                "单位":"MHz",
                "默认值":""
            },
            "接收天线方位角":{
                "类型":"int",
                "描述":"接收天线水平指向的方位角，以正北为0度顺时针旋转，单位：度",
                "默认值":""
            },
            "接收天俯仰角":{
                "类型":"int",
                "描述":"接收天线垂直方向的俯仰角度，0度为水平，单位：度",
                "单位":"度",
                "默认值":""
            },
            "发射天线方位角范围":{
                "类型":"int",
                "描述":"发射天线水平可扫描/覆盖的方位角宽度范围，单位：度",
                "单位":"度",
                "默认值":""
            },
            "发射天线俯仰角范围":{
                "类型":"int",
                "描述":"发射天线垂直可扫描/覆盖的俯仰角宽度范围，单位：度",
                "单位":"度",
                "默认值":""
            },
            "平均功率":{
                "类型":"int",
                "描述":"发射设备平均输出功率，单位：W",
                "单位":"W",
                "默认值":""
            },
            "峰值功率":{
                "类型":"int",
                "描述":"发射设备峰值输出功率，单位：W",
                "单位":"W",
                "默认值":""
            },
            "载波功率":{
                "类型":"int",
                "描述":"载波信号输出功率，单位：W",
                "单位":"W",
                "默认值":""
            },
            "单位":{
                "类型":"int",
                "描述":"该设备对应的部队编制或建制单位编号",
                "默认值":""
            },
            "调试方式":{
                "类型":"int",
                "描述":"信号调制方式，如调幅、调频、调相等",
                "默认值":""
            },
            "干扰保护门限":{
                "类型":"int",
                "描述":"设备能容忍的最大干扰信号强度阈值，超过此值将无法正常工作，单位：dBm",
                "单位":"dBm",
                "默认值":""
            }
        }
    }
}
