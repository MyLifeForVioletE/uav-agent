{
     "equipment_radio_extd":{
        "类型":"struct",
        "描述":"通信装备扩展参数，包含调制方式、跳频扩频、收发频率范围及探测距离",
        "参数":{
            "装备ID":{
                "类型":"string",
                "描述":"关联的装备ID",
                "默认值":""
            },
            "调制方式":{
                "类型":"string",
                "描述":"通信信号调制方式，如AM、FM、PSK等",
                "默认值":""
            },
            "码速率":{
                "类型":"string",
                "描述":"通信码速率，单位：bps",
                "默认值":""
            },
            "发射工作频率起":{
                "类型":"string",
                "描述":"发射工作频率起始值，单位：MHz",
                "默认值":""
            },
            "发射工作频率止":{
                "类型":"string",
                "描述":"发射工作频率终止值，单位：MHz",
                "默认值":""
            },
            "是否跳频":{
                "类型":"string",
                "描述":"是否使用跳频技术，0-否、1-是",
                "默认值":""
            },
            "跳速":{
                "类型":"string",
                "描述":"跳频速率，单位：跳/秒",
                "默认值":""
            },
            "跳频序列":{
                "类型":"string",
                "描述":"跳频序列编码",
                "默认值":""
            },
            "是否扩频":{
                "类型":"string",
                "描述":"是否使用扩频技术，0-否、1-是",
                "默认值":""
            },
            "扩频带宽":{
                "类型":"string",
                "描述":"扩频信号带宽，单位：MHz",
                "默认值":""
            },
            "收发频率间隔":{
                "类型":"string",
                "描述":"收发频率间隔，单位：MHz",
                "默认值":""
            },
            "发射馈线损耗":{
                "类型":"string",
                "描述":"发射馈线损耗，单位：dB",
                "默认值":""
            },
            "接收馈线损耗":{
                "类型":"string",
                "描述":"接收馈线损耗，单位：dB",
                "默认值":""
            },
            "全向探测距离":{
                "类型":"int",
                "描述":"通信设备全向感知/探测信号的最大距离，单位：公里",
                "单位":"公里",
                "默认值":""
            },
            "备注":{
                "类型":"string",
                "描述":"通信装备扩展参数备注",
                "默认值":""
            }
        }
    }
}
