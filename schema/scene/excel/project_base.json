{
    "project_base":{
        "类型":"struct",
        "描述":"仿真项目基础信息，包含项目标识、时间范围、区域矢量及用户信息",
        "参数":{
            "项目ID":{
                "类型":"string",
                "描述":"项目的唯一标识ID",
                "默认值":""
            },
            "项目名称":{
                "类型":"string",
                "描述":"项目名称",
                "默认值":""
            },
            "仿真开始时间":{
                "类型":"string",
                "描述":"仿真开始时间",
                "默认值":""
            },
            "仿真结束时间":{
                "类型":"string",
                "描述":"仿真结束时间",
                "默认值":""
            },
            "项目创建时间":{
                "类型":"int",
                "描述":"项目创建时间，Unix时间戳",
                "默认值":""
            },
            "仿真步进":{
                "类型":"int",
                "描述":"仿真时间步进间隔",
                "单位":"秒",
                "默认值":""
            },
            "项目区域矢量ID":{
                "类型":"string",
                "描述":"项目关联的区域矢量ID",
                "默认值":""
            },
            "用户ID":{
                "类型":"int",
                "描述":"项目所属用户ID",
                "默认值":""
            },
            "备注":{
                "类型":"string",
                "描述":"项目备注信息",
                "默认值":""
            },
            "项目模板标识":{
                "类型":"int",
                "描述":"项目模板标识，区分不同项目模板",
                "默认值":""
            }
        }
    }
}
