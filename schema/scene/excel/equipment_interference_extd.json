{
    "equipment_interference_extd":{
        "类型":"struct",
        "描述":"干扰装备扩展参数，包含调制方式、跳频扩频参数、收发频率范围及干扰类型",
        "参数":{
            "装备ID":{
                "类型":"string",
                "描述":"关联的装备ID",
                "默认值":""
            },
            "调制方式":{
                "类型":"string",
                "描述":"信号调制方式，如调幅、调频、调相等",
                "默认值":""
            },
            "码速率":{
                "类型":"string",
                "描述":"信号码元传输速率，单位：bps",
                "默认值":""
            },
            "发射工作频率起":{
                "类型":"string",
                "描述":"发射工作频率起始值，单位：MHz",
                "默认值":""
            },
            "发射工作频率止":{
                "类型":"double",
                "描述":"发射工作频率终止值，单位：MHz",
                "默认值":""
            },
            "是否跳频":{
                "类型":"double",
                "描述":"是否使用跳频技术，0-否、1-是",
                "默认值":""
            },
            "跳速":{
                "类型":"double",
                "描述":"跳频速率，单位：跳/秒",
                "默认值":""
            },
            "跳频序列":{
                "类型":"double",
                "描述":"跳频序列编码",
                "默认值":""
            },
            "是否扩频":{
                "类型":"double",
                "描述":"是否使用扩频技术，0-否、1-是",
                "默认值":""
            },
            "扩频带宽":{
                "类型":"int",
                "描述":"扩频后的信号带宽，单位：MHz",
                "默认值":""
            },
            "收发频率间隔":{
                "类型":"int",
                "描述":"发射与接收频率之间的间隔，单位：MHz",
                "默认值":""
            },
            "发射馈线损耗":{
                "类型":"double",
                "描述":"发射链路的馈线损耗，单位：dB",
                "默认值":""
            },
            "接收馈线损耗":{
                "类型":"double",
                "描述":"接收链路的馈线损耗，单位：dB",
                "默认值":""
            },
            "备注1":{
                "类型":"double",
                "描述":"扩展备注信息1",
                "默认值":""
            },
            "任务类型":{
                "类型":"string",
                "描述":"干扰任务类型，如压制干扰、欺骗干扰等",
                "默认值":""
            },
            "干扰类型":{
                "类型":"bool",
                "描述":"干扰类型标志",
                "默认值":""
            },
            "备注2":{
                "类型":"int",
                "描述":"扩展备注信息2",
                "默认值":""
            }
        }
    }
}
