{
    "equipment_radar_extd":{
        "类型":"struct",
        "描述":"雷达装备扩展参数，包含调制方式、脉冲特性、探测距离及追踪信息",
        "参数":{
            "装备ID":{
                "类型":"string",
                "描述":"关联的装备ID",
                "默认值":""
            },
            "调制方式":{
                "类型":"string",
                "描述":"雷达信号调制方式",
                "默认值":""
            },
            "发射工作频率起":{
                "类型":"string",
                "描述":"雷达发射工作频率起始值，单位：MHz",
                "默认值":""
            },
            "发射工作频率止":{
                "类型":"string",
                "描述":"雷达发射工作频率终止值，单位：MHz",
                "默认值":""
            },
            "脉冲宽度":{
                "类型":"string",
                "描述":"雷达发射脉冲宽度，单位：微秒",
                "默认值":""
            },
            "脉冲重复频率":{
                "类型":"string",
                "描述":"雷达脉冲重复频率，单位：Hz",
                "默认值":""
            },
            "占空比":{
                "类型":"string",
                "描述":"雷达发射信号占空比",
                "默认值":""
            },
            "全向探测距离":{
                "类型":"int",
                "描述":"雷达360度全方位探测的最大距离，单位：公里",
                "单位":"公里",
                "默认值":""
            },
            "立体探测距离":{
                "类型":"int",
                "描述":"雷达立体空间（含高度维度）探测的最大斜距，单位：公里",
                "单位":"公里",
                "默认值":""
            },
            "立体盲区距离":{
                "类型":"int",
                "描述":"雷达立体探测时无法探测的近距盲区范围，单位：公里",
                "单位":"公里",
                "默认值":""
            },
            "立体的仰角":{
                "类型":"int",
                "描述":"雷达立体探测波束的俯仰角度范围，单位：度",
                "单位":"度",
                "默认值":""
            },
            "雷达水平探测范围":{
                "类型":"int",
                "描述":"雷达水平方向可覆盖的扇形区域角度宽度，单位：度",
                "单位":"度",
                "默认值":""
            },
            "雷达水平角度":{
                "类型":"int",
                "描述":"雷达水平波束的指向方位角，以正北为0度顺时针旋转，单位：度",
                "单位":"度",
                "默认值":""
            },
            "定向探测距离":{
                "类型":"int",
                "描述":"雷达定向波束（窄波束）的最大探测距离，单位：公里",
                "单位":"公里",
                "默认值":""
            },
            "仰角":{
                "类型":"int",
                "描述":"雷达波束的俯仰角度，0度水平，正值为向上仰角，单位：度",
                "单位":"度",
                "默认值":""
            },
            "雷达追踪载体的ID":{
                "类型":"int",
                "描述":"雷达当前追踪的目标载体ID",
                "默认值":""
            },
            "雷达工作类型":{
                "类型":"int",
                "描述":"雷达工作模式类型，如搜索、跟踪、扫描等",
                "默认值":""
            },
            "备注":{
                "类型":"int",
                "描述":"备注（memo），雷达扩展参数备注",
                "默认值":""
            }
        }
    }
}
