{
    "antenna_pattern_h":{
        "类型":"struct",
        "描述":"天线水平方向图数据，描述天线在水平面上各角度的增益/损耗分布",
        "参数":{
            "天线ID":{
                "类型":"string",
                "描述":"天线ID（antId），关联的天线唯一标识",
                "默认值":""
            },
            "水平角度":{
                "类型":"string",
                "描述":"水平角度（HAngle），天线水平方向图的角度值，单位：度",
                "默认值":""
            },
            "损耗":{
                "类型":"string",
                "描述":"损耗（loss），对应水平角度的天线增益/损耗值，单位：dB",
                "默认值":""
            }
        }
    }
}
