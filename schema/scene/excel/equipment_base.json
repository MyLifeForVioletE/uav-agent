{
    "equipment_base":{
        "类型":"struct",
        "描述":"载体上安装装备基础信息，包含装备标识、功率参数、天线参数、馈线损耗及工作状态",
        "参数":{
            "装备ID":{
                "类型":"string",
                "描述":"装备的唯一标识编号",
                "默认值":""
            },
            "装备名称":{
                "类型":"string",
                "描述":"装备的名称或代号",
                "默认值":""
            },
            "装备模型ID":{
                "类型":"string",
                "描述":"装备关联的模型ID",
                "默认值":""
            },
            "所在载体ID":{
                "类型":"string",
                "描述":"装备所在载体的ID",
                "默认值":""
            },
            "平均功率":{
                "类型":"double",
                "描述":"装备的平均输出功率，单位：W",
                "默认值":""
            },
            "峰值功率":{
                "类型":"double",
                "描述":"装备的峰值输出功率，单位：W",
                "默认值":""
            },
            "载波功率":{
                "类型":"double",
                "描述":"装备载波信号功率，单位：W",
                "默认值":""
            },
            "必要带宽":{
                "类型":"double",
                "描述":"装备工作所需的必要带宽，单位：Hz",
                "默认值":""
            },
            "在载体上的高度":{
                "类型":"double",
                "描述":"装备在载体上的安装高度，单位：米",
                "默认值":""
            },
            "天线方位角":{
                "类型":"double",
                "描述":"装备天线水平指向的方位角，以正北为0度顺时针旋转，单位：度",
                "默认值":""
            },
            "天线俯仰角":{
                "类型":"double",
                "描述":"装备天线垂直方向的俯仰角度，0度为水平，单位：度",
                "默认值":""
            },
            "当前工作参数ID":{
                "类型":"string",
                "描述":"装备当前使用的工作参数模板ID",
                "默认值":""
            },
            "发射馈线损耗":{
                "类型":"double",
                "描述":"发射链路的馈线损耗，单位：dB",
                "默认值":""
            },
            "接收馈线损耗":{
                "类型":"double",
                "描述":"接收链路的馈线损耗，单位：dB",
                "默认值":""
            },
            "链接发射机的id":{
                "类型":"string",
                "描述":"关联发射机的ID",
                "默认值":""
            },
            "装备开机状态":{
                "类型":"bool",
                "描述":"装备开关机状态，true-开机、false-关机",
                "默认值":""
            },
            "优先级":{
                "类型":"int",
                "描述":"装备的工作优先级，数值越小优先级越高",
                "默认值":""
            }
        }
    }
}
