{
    "carrier_info":{
        "类型":"struct",
        "描述":"载体装备信息，包含载体标识、位置坐标、运动状态、所属阵营和时间参数",
        "参数":{
            "载体ID":{
                "类型":"string",
                "描述":"载体装备的唯一标识编号",
                "默认值":""
            },
            "载体名称":{
                "类型":"string",
                "描述":"载体装备的名称或代号",
                "默认值":""
            },
            "载体模型ID":{
                "类型":"string",
                "描述":"载体所属模型/型号的ID，关联载体装备中的参数定义",
                "默认值":""
            },
            "载体平台ID":{
                "类型":"string",
                "描述":"载体所属平台的ID",
                "默认值":""
            },
            "项目ID":{
                "类型":"string",
                "描述":"载体所属仿真项目的ID",
                "默认值":""
            },
            "经度":{
                "类型":"double",
                "描述":"载体所在地理位置的经度，东经为正，西经为负，单位：度",
                "单位":"度",
                "默认值":""
            },
            "纬度":{
                "类型":"double",
                "描述":"载体所在地理位置的纬度，北纬为正，南纬为负，单位：度",
                "单位":"度",
                "默认值":""
            },
            "海拔高度":{
                "类型":"int",
                "描述":"载体所在地的海拔高度，单位：米",
                "单位":"米",
                "默认值":""
            },
            "所属阵营":{
                "类型":"string",
                "描述":"载体所属的阵营，如红方、蓝方、中立等",
                "默认值":""
            },
            "水平朝向":{
                "类型":"int",
                "描述":"载体当前的朝向方位角，以正北为0度顺时针旋转，单位：度",
                "单位":"度",
                "默认值":""
            },
            "速度":{
                "类型":"int",
                "描述":"载体当前的移动速度，单位：米/秒",
                "单位":"千米/小时",
                "默认值":""
            },
            "运动标志":{
                "类型":"int",
                "描述":"载体运动状态标志，0-静止、1-匀速运动、2-加速运动",
                "默认值":""
            },
            "编队的路径ID":{
                "类型":"string",
                "描述":"载体编队飞行/行驶的路径ID",
                "默认值":""
            },
            "载体开始工作时间":{
                "类型":"string",
                "描述":"载体开始工作的时间点",
                "默认值":""
            },
            "载体接收工作时间":{
                "类型":"string",
                "描述":"载体接收工作指令的时间点",
                "默认值":""
            }
        }
    }
}
