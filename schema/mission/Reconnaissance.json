{
    "任务编号":{
        "类型":"int",
        "值":{
            "情报获取侦察":0,
            "对抗干扰":1,
            "通信保障":2
        },
        "描述":"任务名称唯一标识，和任务类型相对应",
        "默认值":0
    },
    "任务类型":{
        "类型":"string",
        "值":["情报获取侦察","对抗干扰","通信保障"],
        "默认值":"情报获取侦察"
    },
    "任务优先级":{
        "类型":"int",
        "最大值":5,
        "最小值":1,
        "描述":"值越大，优先级越高",
        "默认值":1
    },
    "军事禁区开关":{
        "类型":"int",
        "值":{
            "开":1,
            "关":0
        },
        "默认值":0
    },
    "电子围栏开关":{
        "类型":"int",
        "值":{
            "开":1,
            "关":0
        },
        "默认值":0
    },
    "任务完成标准":{
        "类型":"bool",
        "值":{
            "开":true,
            "关":false
        },
        "描述":"是否给出任务完成标志",
        "默认值":false
    },
    "起飞点经度":{
        "类型":"double",
        "最小值":-180.0,
        "最大值":180.0,
        "默认值":0.0
    },
    "起飞点纬度":{
        "类型":"double",
        "最小值":-90.0,
        "最大值":90.0,
        "默认值":0.0
    },
    "目标区域经度":{
        "类型":"double",
        "最小值":-180.0,
        "最大值":180.0,
        "默认值":0.0
    },
    "目标区域纬度":{
        "类型":"double",
        "最小值":-90.0,
        "最大值":90.0,
        "默认值":0.0
    },
    "沿途地形":{
        "类型":"string",
        "值":["平原","丘陵","山区","城市","森林","沙漠","湿地","河流","湖泊","海洋"],
        "描述":"沿途地形类型，输出必须是列出的合法值",
        "默认值":"平原"
    },
    "最大任务时长":{
        "类型":"int",
        "描述":"任务执行时间",
        "默认值(分钟)":0
    },
    "任务开始时间":{
        "类型":"string",
        "最小值":"00:00:00",
        "最大值":"23:59:59",
        "默认值":"12:00:00"
    },
    "电池续航电量":{
        "类型":"int",
        "最小值(%)":0,
        "最大值(%)":100,
        "默认值":100
    },
    "最大飞行高度":{
        "类型":"int",
        "最小值(米)":0,
        "最大值(米)":120,
        "描述":"空域限制高度",
        "默认值":120
    },
    "规则库更新":{
        "类型":"int",
        "值":{
            "本地":0,
            "实时":1
        },
        "默认值":0
    },
    "机载类型":{
        "类型":"int",
        "值":{
            "光电":1,
            "雷达":2,
            "光电+雷达":3
        },
        "默认值":1
    },
    "机载名称":{
        "类型":"string",
        "值":["光电","雷达","光电+雷达"],
        "默认值":"光电"
    },
    "载荷开关":{
        "类型":"int",
        "值":{
            "关":0,
            "开":1
        },
        "描述":"机载载荷开关状态：无人机未执行任务时是关闭状态，任务开始执行后是打开状态",
        "默认值":0
    },
    "侦察目标":{
        "类型":"string",
        "值":["车辆","工事","电磁信号源"],
        "默认值":"车辆"
    },
    "目标中心频率":{
        "类型":"double",
        "默认值(Mhz)":0.0
    },
    "目标带宽":{
        "类型":"double",
        "默认值(Mhz)":0.0
    },
    "目标功率":{
        "类型":"double",
        "默认值(Mhz)":0.0
    },
    "扫描模式":{
        "类型":"string",
        "值":["定点详查","全域扫描"],
        "默认值":"定点详查"
    }
}