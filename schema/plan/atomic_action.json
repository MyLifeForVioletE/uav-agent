{
    "type":"object",
    "additionalProperties":false,
    "required":["actions"],
    "properties":{
        "actions":{
            "type":"array",
            "minItems":1,
            "items":{
                "oneOf":[
                    {
                        "type":"object",
                        "additionalProperties":false,
                        "required":["action_id","phase_id","action_name","goal","post_action_update","executor","tool_name","tool_inputs","done_when","failure_policy"],
                        "properties":{
                            "action_id":{"type":"string"},
                            "phase_id":{"type":"string"},
                            "action_name":{"type":"string"},
                            "goal":{"type":"string","description":"某个无人机执行该动作的目标描述，用于执行时指导参数解析。例如：无人机1以无人机1当前位置为起点，以目标1为终点，规划航线"},
                            "post_action_update":{"type":"string","description":"执行后要更新 Redis 上下文的自然语言指令。例如：\"将无人机1当前位置更新为目标1的坐标位置\"。系统会自动根据该指令、动作目标(goal)和已解析的参数值决定具体更新内容"},
                            "executor":{"type":"string","const":"tool"},
                            "tool_name":{"type":"string","description":"必须是已注册算法工具列表中的名称"},
                            "tool_inputs":{"type":"object","description":"必须严格按该工具input_schema中定义的参数名提供","additionalProperties":{"type":"string"}},
                            "outputs":{"type":"array","items":{"type":"string"}},
                            "done_when":{"type":"string"},
                            "failure_policy":{"type":["string","null"]}
                        }
                    },
                    {
                        "type":"object",
                        "additionalProperties":false,
                        "required":["action_id","phase_id","action_name","goal","executor","done_when","failure_policy"],
                        "properties":{
                            "action_id":{"type":"string"},
                            "phase_id":{"type":"string"},
                            "action_name":{"type":"string"},
                            "goal":{"type":"string","description":"该动作的目标描述，供执行参考。例如：无人机沿航线从当前位置飞行到目标位置1"},
                            "executor":{"type":"string","const":"external"},
                            "required_inputs":{"type":"array","items":{"type":"string"}},
                            "outputs":{"type":"array","items":{"type":"string"}},
                            "done_when":{"type":"string"},
                            "failure_policy":{"type":["string","null"]}
                        }
                    },
                    {
                        "type":"object",
                        "additionalProperties":false,
                        "required":["action_id","phase_id","action_name","goal","executor","done_when","failure_policy"],
                        "properties":{
                            "action_id":{"type":"string"},
                            "phase_id":{"type":"string"},
                            "action_name":{"type":"string"},
                            "goal":{"type":"string","description":"该动作的目标描述，供执行参考。例如：保存航线数据到本地"},
                            "executor":{"type":"string","const":"system"},
                            "required_inputs":{"type":"array","items":{"type":"string"}},
                            "outputs":{"type":"array","items":{"type":"string"}},
                            "done_when":{"type":"string"},
                            "failure_policy":{"type":["string","null"]}
                        }
                    }
                ]
            }
        }
    }
}
