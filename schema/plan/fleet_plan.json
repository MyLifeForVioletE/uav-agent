{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "FleetPlan",
    "description": "多机协同任务规划的JSON Schema",
    "type": "object",
    "required": ["scenario", "uav_count", "sub_tasks"],
    "properties": {
        "scenario": {
            "type": "string",
            "description": "多机协同任务场景描述"
        },
        "uav_count": {
            "type": "integer",
            "minimum": 1,
            "description": "可用的无人机数量（必须严格根据用户描述填写）"
        },
        "sub_tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["task_id", "task_name", "goal"],
                "properties": {
                    "task_id": {
                        "type": "string",
                        "description": "子任务唯一标识"
                    },
                    "task_name": {
                        "type": "string",
                        "description": "子任务名称"
                    },
                    "goal": {
                        "type": "string",
                        "description": "子任务目标"
                    },
                    "executor": {
                        "type": "string",
                        "enum": ["coordinator", "uav", "processor"],
                        "description": "执行者：uav=无人机子agent执行，processor=信息处理agent执行，coordinator=主agent执行（仅限最终决策）"
                    },
                    "assigned_uav_role": {
                        "type": "string",
                        "description": "期望分配的UAV角色（由分配器调整）"
                    },
                    "prerequisite_tasks": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "前置依赖的 task_id 列表"
                    },
                    "constraints": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "该子任务的特殊约束"
                    }
                }
            }
        }
    }
}
